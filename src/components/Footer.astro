---
import { ui, homePath, type Lang } from '../i18n/ui';
import { tools, games, contact } from '../data/works';

interface Props {
  lang: Lang;
  sub?: boolean; // 子页面：链接要先回到首页
}
const { lang, sub } = Astro.props;
const t = ui[lang].footer;
const home = sub ? homePath[lang] : '';
---

<footer class="footer">
  <div class="wrap foot-inner">
    <div class="foot-brand">
      <a class="brand" href={home || '#top'}><span class="brand-mark" aria-hidden="true"></span>hongist</a>
      <p>{t.tagline}</p>
    </div>
    <nav class="foot-cols" aria-label={t.label}>
      <div>
        <p class="foot-h">{t.tools}</p>
        {tools.map((tool) => <a href={tool.url} target="_blank" rel="noopener">{tool.name[lang]}</a>)}
      </div>
      <div>
        <p class="foot-h">{t.games}</p>
        <a href={`${home}#app-saolei`}>{games.saolei.name[lang]}</a>
        <a href={games.zaza.path[lang]}>{games.zaza.name[lang]}</a>
      </div>
      <div>
        <p class="foot-h">{t.contact}</p>
        <a href={`mailto:${contact.email}`}>{t.email}</a>
      </div>
    </nav>
  </div>
  <div class="wrap">
    <p class="foot-legal">© {new Date().getFullYear()} Hong · hongist.com</p>
  </div>
</footer>
