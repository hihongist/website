---
import { ui, type Lang } from '../i18n/ui';
import { games, contact } from '../data/works';
import ZazaScene from './ZazaScene.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const g = t.games;
const { saolei, zaza } = games;
const mail = (subject: string) => `mailto:${contact.email}?subject=${encodeURIComponent(subject)}`;
const searchIcon = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9.5 4C5.4 4 2 6.8 2 10.3c0 2 1.1 3.7 2.8 4.9L4.2 17.4l2.6-1.3c.8.2 1.7.4 2.7.4h.4a5.6 5.6 0 0 1-.2-1.5c0-3.4 3.2-6.1 7.2-6.1h.5C16.7 6.1 13.4 4 9.5 4Z"/><path d="M22 14.9c0-2.8-2.7-5-6-5s-6 2.2-6 5 2.7 5 6 5c.7 0 1.4-.1 2-.3l2.1 1.1-.5-1.8c1.5-1 2.4-2.4 2.4-4Z"/></svg>';
---

<section class="section games" id="games">
  <div class="games-glow" aria-hidden="true"></div>
  <div class="wrap">
    <header class="sec-head">
      <p class="eyebrow"><span class="dot dot-wx"></span>{g.eyebrow}</p>
      <h2 class="sec-title"><span class="ph">{g.title[0]}</span>{lang === 'en' ? ' ' : ''}<span class="ph">{g.title[1]}</span></h2>
      <p class="sec-sub">{g.sub}</p>
    </header>

    <div class="games-grid">
      <!-- 猫咪扫雷：左边是能直接玩的 5×5 棋盘 -->
      <article class="saolei card" id="app-saolei">
        <div class="sl-panel" data-saolei data-msgs={JSON.stringify(t.saolei.demo)}>
          <div class="sl-top">
            <span class="sl-pill">{t.saolei.demo.tryIt}</span>
            <span class="sl-pill" data-sl-count>{t.saolei.demo.placed.replace('{n}', '0')}</span>
          </div>
          <div class="sl-board" data-sl-board role="grid" aria-label={t.saolei.demo.board}></div>
          <div class="sl-foot">
            <p class="sl-msg" data-sl-msg aria-live="polite">{t.saolei.demo.hint}</p>
            <button class="sl-btn" data-sl-reset type="button">{t.saolei.demo.reset}</button>
          </div>
        </div>
        <div class="saolei-copy">
          <span class="state state-live" style="align-self: flex-start"><i></i>{g.live}</span>
          <div class="game-head">
            <span class="ico ico-md"><img src={saolei.icon} alt="" width="128" height="128" /></span>
            <div>
              <h3 class="game-title">{saolei.name[lang]}</h3>
              {saolei.altName[lang] && <p class="game-tags">{saolei.altName[lang]}</p>}
            </div>
          </div>
          <p class="saolei-lede">{t.saolei.lede}</p>
          <ul class="rules">
            {t.saolei.rules.map((r, i) => <li><b>{String(i + 1).padStart(2, '0')}</b>{r}</li>)}
          </ul>
          <div class="chips">{t.saolei.chips.map((c) => <span class="chip">{c}</span>)}</div>
          {saolei.miniCode ? (
            <div class="qr-row">
              <img class="qr-code" src={saolei.miniCode} alt="" width="96" height="96" />
              <div class="qr-copy">
                <p class="qr-title">{g.scan}</p>
                <p>{g.orSearch(saolei.wxName)}</p>
              </div>
            </div>
          ) : (
            <p class="find-hint"><Fragment set:html={searchIcon} /><span>{g.search(saolei.wxName)}</span></p>
          )}
        </div>
      </article>

      <!-- 猫咪砸砸乐：开发中 -->
      <article class="zaza card spot" id="app-zaza">
        <div class="zaza-cover" aria-hidden="true">
          <ZazaScene />
          <div class="receipt">
            <p class="r-head">{t.zaza.receipt.head}</p>
            <p class="r-sub">{t.zaza.receipt.sub}</p>
            {t.zaza.receipt.lines.map(([k, v]) => <p><span>{k}</span><span>{v}</span></p>)}
            <p class="r-total"><span>{t.zaza.receipt.total[0]}</span><span>{t.zaza.receipt.total[1]}</span></p>
          </div>
        </div>
        <div class="zaza-body">
          <span class="state state-dev" style="align-self: flex-start"><i></i>{g.dev}</span>
          <div class="game-head">
            <span class="ico ico-sm"><img src={zaza.icon} alt="" width="80" height="80" /></span>
            <div>
              <h3 class="game-title">{zaza.name[lang]}</h3>
              <p class="game-tags">{zaza.altName[lang] ? `${zaza.altName[lang]} · ${zaza.tags[lang]}` : zaza.tags[lang]}</p>
            </div>
          </div>
          <p>{t.zaza.desc}</p>
          <a class="btn btn-ghost" href={mail(t.zaza.ctaSubject)}>{t.zaza.cta}</a>
        </div>
      </article>

      <!-- 下一款 -->
      <article class="next-game card" id="next-game">
        <span class="ico ico-ghost"><span>+</span></span>
        <h3>{t.next.title}</h3>
        <p>{t.next.desc}</p>
        <a class="link-arrow" href="#about">{t.next.link}</a>
      </article>
    </div>
  </div>
</section>

<script>
  import '../scripts/saolei';
</script>
