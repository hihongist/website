---
import { ui, homePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  // 子页面传这一页中英文两个版本的地址：导航会回到首页对应的区块，语言按钮切到这一页的另一种语言
  paths?: Record<Lang, string>;
}
const { lang, paths } = Astro.props;
const t = ui[lang].nav;
const other: Lang = lang === 'zh' ? 'en' : 'zh';
const home = paths ? homePath[lang] : '';
const otherHref = (paths ?? homePath)[other];
---

<header class="menubar">
  <div class="menubar-inner">
    <a class="brand" href={home || '#top'}><span class="brand-mark" aria-hidden="true"></span>hongist</a>
    <nav class="menus" id="menus" aria-label={t.label}>
      <a href={`${home}#tools`}>{t.tools}</a>
      <a href={`${home}#games`}>{t.games}</a>
      <a href={`${home}#about`}>{t.about}</a>
    </nav>
    <div class="status">
      <button class="sb-btn" type="button" data-theme-toggle aria-label={t.theme}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"></circle><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"></path></svg>
      </button>
      <a class="sb-btn" href={otherHref} hreflang={other === 'zh' ? 'zh-CN' : 'en'} aria-label={t.otherLabel}>{t.other}</a>
      <span class="sb-text clock" data-clock></span>
      <button class="sb-btn menu-btn" type="button" data-menu-btn aria-expanded="false" aria-controls="menus" aria-label={t.menu}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
    </div>
  </div>
</header>
