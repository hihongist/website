---
import { ui, type Lang } from '../i18n/ui';
import { dockItems, tools, games } from '../data/works';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const groups = dockItems(lang, t.kinds);
const icon = (slug: string) => tools.find((x) => x.slug === slug)?.icon;
---

<section class="hero" id="top">
  <div class="aurora" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <a class="status-pill" href="#app-zaza"><span class="pulse"></span>{t.hero.pill}</a>
      <h1 class="hero-title">
        {t.hero.title.map((line, i) => (
          <>
            {i > 0 && <br />}
            <span class="ph">{line.pre}<span class:list={['hl', i === 1 && 'hl-wx']}>{line.hl}</span>{line.post}</span>
          </>
        ))}
      </h1>
    </div>

    <!-- 右侧：真实作品的界面浮在光晕上，四周渐隐进背景 -->
    <div class="hero-visual" aria-hidden="true">
      <div class="hv-glow"></div>
      <img class="hv hv-thendo" src="/works/thendo-shot.webp" alt="" width="720" height="960" />
      <img class="hv hv-cal" src="/works/scalendar-shot.webp" alt="" width="676" height="1096" />
      <img class="hv hv-phone" src={`/works/safeshot-shot-${lang}.webp`} alt="" width="600" height="1263" />
      <img class="hv hv-ico hv-ico-1" src={icon('dropedge')} alt="" width="128" height="128" />
      <img class="hv hv-ico hv-ico-2" src={games.saolei.icon} alt="" width="128" height="128" />
      <img class="hv hv-ico hv-ico-3" src={games.zaza.icon} alt="" width="128" height="128" />
    </div>
  </div>

  <div class="dock-stage">
    <div class="dock-rail">
      <nav class="dock" id="dock" aria-label={t.hero.dockLabel}>
        {groups.map((group, gi) => (
          <>
            {gi > 0 && <span class="dock-sep" aria-hidden="true"></span>}
            {group.map((item) => (
              <a class="dock-item" href={item.href} data-label={item.label} aria-label={item.label}>
                {item.icon ? (
                  <span class="ico"><img src={item.icon} alt="" width="128" height="128" /></span>
                ) : (
                  <span class="ico ico-ghost"><span>+</span></span>
                )}
                {item.running && <i class="run"></i>}
              </a>
            ))}
          </>
        ))}
      </nav>
    </div>
  </div>
</section>

<script>
  import '../scripts/dock';
  import '../scripts/hero';
</script>
