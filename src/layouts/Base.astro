---
import '@fontsource-variable/geist';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
import '@fontsource/zcool-kuaile/400.css';
import '../styles/global.css';
import { ui, htmlLang, homePath, langs, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  // 子页面（比如游戏主页、隐私政策）传自己的标题、描述，和这一页中英文两个版本的地址；不传就是首页
  title?: string;
  description?: string;
  paths?: Record<Lang, string>;
  image?: string;     // 分享到聊天软件时显示的预览图（站内路径）
  noindex?: boolean;  // 不让搜索引擎收录（比如带参数的挑战页）
}
const { lang } = Astro.props;
const t = ui[lang];
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;
const paths = Astro.props.paths ?? homePath;
const url = (l: Lang) => new URL(paths[l], Astro.site).href;
const image = Astro.props.image ? new URL(Astro.props.image, Astro.site).href : undefined;
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url(lang)} />
    {langs.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={url(l)} />)}
    <link rel="alternate" hreflang="x-default" href={url('zh')} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#F3F4F8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#090B11" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url(lang)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={htmlLang[lang].replace('-', '_')} />
    {image && <meta property="og:image" content={image} />}
    {image && <meta name="twitter:card" content="summary_large_image" />}
    {Astro.props.noindex && <meta name="robots" content="noindex" />}
    <slot name="head" />
    <script is:inline>
      try {
        var saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
